APP_NAME="Training Companion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ⚠️ OBBLIGATORIA. Eloquent NON converte il fuso in scrittura: ogni timestamp
# proveniente dall'esterno va normalizzato esplicitamente. Vedi plan_trainingbe.md §14.
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# dev: MariaDB 10.4 di XAMPP · staging: MariaDB 11.4 LTS (vedi B10.4)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=training_companion
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI — vedi plan_trainingbe.md §9 (matrice modelli/costi) e §10 (config)
# Il driver e i modelli si cambiano da qui SENZA toccare il codice.
# Override per-tenant su tenants.ai_driver.
# ---------------------------------------------------------------------------
AI_DRIVER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Un modello per task: stimare un piatto da una frase e fare il parsing di un
# PDF di scheda differiscono di un ordine di grandezza in difficolta'.
AI_MODEL_FOOD_TEXT=claude-haiku-4-5
AI_MODEL_FOOD_PHOTO=claude-sonnet-5
AI_MODEL_WORKOUT_KCAL=claude-haiku-4-5
AI_MODEL_ADVICE=claude-haiku-4-5

# ⚠️ MAI un modello a contesto 200K qui: il limite dei PDF scende da 600 a 100 pagine.
AI_MODEL_PDF_IMPORT=claude-sonnet-5
AI_MODEL_PDF_ESCALATION=claude-opus-5
AI_PDF_ESCALATION_CONFIDENCE=0.7

# Quota mensile di token per i tenant senza cap esplicito
AI_DEFAULT_MONTHLY_TOKENS=2000000

# ---------------------------------------------------------------------------
# Reverb — chat trainer <-> iscritto (fase B8)
# ---------------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
# ⚠️ 8081 e NON 8080 (ADR-12): su test-server la 8080 e' gia' occupata dal
# reverb di lepatenti.it, e quel server e' condiviso — non si tocca.
REVERB_PORT=8081
REVERB_SCHEME=http

# Per attivare i socket in produzione: BROADCAST_CONNECTION=reverb.
# Con `log` (default) la chat funziona comunque: l'app ricade sul polling a 15s,
# che e' il contratto previsto da B8.4 proprio per questo caso.

# ---------------------------------------------------------------------------
# Notifiche push (B10.6)
# Il driver `log` scrive cosa avrebbe mandato: senza credenziali il sistema
# funziona lo stesso invece di rompersi.
# ---------------------------------------------------------------------------
PUSH_DRIVER=log
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Immagini inviate all'AI (B6)
# 1568 px sul lato lungo: oltre, i token immagine crescono con l'area senza
# migliorare la stima di un piatto.
# ---------------------------------------------------------------------------
AI_IMAGE_MAX_EDGE=1568
AI_IMAGE_JPEG_QUALITY=85
AI_ADVICE_ENABLED=true

# ---------------------------------------------------------------------------
# Seeder — usate SOLO da SuperAdminSeeder (fase B1.8)
# ---------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=admin@example.test
SEED_SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
DEMO_USER_PASSWORD=
DEV_QUICK_LOGIN=
SEED_SUPERADMIN_USERNAME=

# Stripe — i NOMI, mai i valori.
# 🚨 In sviluppo si usano le chiavi di TEST (pk_test_/sk_test_): con quelle
#    live un test che parte per sbaglio muove soldi veri.
# ⚠️ Il segreto dei webhook non e' facoltativo: la conferma di un pagamento
#    deve arrivare dal webhook firmato, non dal ritorno del browser.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
